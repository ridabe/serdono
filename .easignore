# EAS Build lê ESTE arquivo em vez do .gitignore quando ele existe (não
# mescla os dois) — por isso repete tudo que o .gitignore já ignora, mais as
# entradas abaixo que causam falha no upload do tarball no Windows.

# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/

# Build outputs
build/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# graphify
graphify-out/

# Ferramentas de IA (Claude Code) — nada disso entra no build do app, e
# `.claude/skills/*` tem link simbólico apontando pra fora do repo, que o
# Windows não consegue empacotar sem privilégio elevado (EPERM real,
# encontrado rodando `eas build --platform android --profile preview`
# em 09/08/2026, SPEC.md SDD-93).
.claude/
.agents/

# Docs não precisam ir pro build nativo
docs/
